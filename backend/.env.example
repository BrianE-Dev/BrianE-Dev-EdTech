APP_ENV=development
MONGODB_URI=
# Optional temporary Hostinger outbound-IP diagnostic. Use a random token of at least 32 characters; remove after testing.
HOSTINGER_DIAGNOSTIC_TOKEN=
PORT=4000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=https://briane-dev.online
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
NODE_ENV=development
# Optional, temporary seed-only admin creation; unset after creating the account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Server-only Hostinger Email SMTP. Confirm the manual settings in hPanel before production use.
PUBLIC_APP_URL=https://briane-dev.online
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@briane-dev.online
SMTP_PASSWORD=
EMAIL_ADMIN_RECIPIENT=info@briane-dev.online
EMAIL_REPLY_TO=info@briane-dev.online

# Server-only Gemini TTS configuration. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE=en-US

# Development may use local storage. Production must use persistent S3-compatible object storage.
TTS_STORAGE_PROVIDER=local
TTS_S3_ENDPOINT=
TTS_S3_BUCKET=
TTS_S3_REGION=
TTS_S3_ACCESS_KEY_ID=
TTS_S3_SECRET_ACCESS_KEY=
