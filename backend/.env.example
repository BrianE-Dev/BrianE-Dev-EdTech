APP_ENV=development
MONGODB_URI=
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace_with_test_webhook_secret
PAYSTACK_BASE_URL=https://api.paystack.co
NODE_ENV=development
# Optional, temporary seed-only admin creation; unset after creating the account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Server-only Gemini TTS configuration. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_LANGUAGE=en-US

# Development may use local storage. Production must use persistent S3-compatible object storage.
TTS_STORAGE_PROVIDER=local
TTS_S3_ENDPOINT=
TTS_S3_BUCKET=
TTS_S3_REGION=
TTS_S3_ACCESS_KEY_ID=
TTS_S3_SECRET_ACCESS_KEY=
