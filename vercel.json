{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://briane-dev-api.onrender.com/api/:path*" },
    { "source": "/course/ai-powered-developer-productivity", "destination": "/course/ai-powered-developer-productivity/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/insights", "destination": "/insights/index.html" },
    { "source": "/insights/using-ai-effectively-in-software-development", "destination": "/insights/using-ai-effectively-in-software-development/index.html" },
    { "source": "/insights/when-not-to-use-ai-for-coding", "destination": "/insights/when-not-to-use-ai-for-coding/index.html" },
    { "source": "/insights/ai-assisted-development-workflows-for-junior-developers", "destination": "/insights/ai-assisted-development-workflows-for-junior-developers/index.html" },
    { "source": "/insights/:slug", "destination": "/insights/404.html", "status": 404 },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/quote", "destination": "/quote/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
