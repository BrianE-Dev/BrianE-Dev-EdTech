{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://briane-dev-api.onrender.com/api/:path*" },
    { "source": "/course/ai-powered-developer-productivity", "destination": "/course/ai-powered-developer-productivity/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
